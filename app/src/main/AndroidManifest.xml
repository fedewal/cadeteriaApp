<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- CAMARA: para escanear la etiqueta del equipo al cerrar un evento. Es el
         unico permiso sensible que la app pide, y se pide cuando se usa, no al
         instalar. `required="false"` a proposito: un telefono sin camara sigue
         pudiendo usar el resto de la app (la pantalla cae al tipeo). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- INSTALAR: la app baja el APK y abre el instalador ella misma. Antes abria
         la descarga en Chrome, y Chrome DESCARTA los .apk (su analisis de
         seguridad los bloquea): la barra se llenaba al instante y el archivo
         nunca aparecia en Descargas. Reportado por Federico el 2026-09-25.
         Con la actualizacion obligatoria esto pasa de molesto a grave: el cartel
         no se puede cerrar y el cadete quedaria encerrado sin forma de salir. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- AVISOS: el cadete pide algo desde el campo y la oficina le contesta por
         chat. El aviso tiene que llegar con el telefono en el bolsillo, asi que
         hace falta un servicio en PRIMER PLANO (desde Android 8 uno comun se
         muere a los minutos) con su notificacion permanente, que va en un canal
         de importancia MINIMA para quedar plegada y muda.
         Esta adentro de esta app a proposito, en vez de pedirle al cadete que
         instale tambien la app de ntfy: dos apps para configurar en cada
         telefono, y una suscripcion que cualquiera puede borrar o silenciar sin
         que nadie se entere. Ver AvisosService.
         (La ubicacion va aparte, abajo: es otro servicio, con otro tipo.) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- UBICACION: un punto cada 10 s para el mapa del centro de mando (hito 2),
         el mismo seguimiento que vendedoresApp. Hasta la 0.6 no habia nada de
         ubicacion porque el recorrido lo cubria SimpliRoute; el mapa necesita
         la linea completa, parado incluido, y SimpliRoute no la da.
         BACKGROUND hace falta para seguir con la pantalla apagada (Android 10+),
         y FOREGROUND_SERVICE_LOCATION para el tipo del servicio (Android 14). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- `dataSync` y no `remoteMessaging` porque `targetSdk` es 34. OJO al
             subirlo a 35+: ahi Android 15 le pone un tope de 6 h por dia a
             `dataSync`, y un cadete trabaja mas que eso; el tipo correcto
             pasa a ser `remoteMessaging`, que es justo este caso y no tiene
             tope. Si se sube el target sin cambiar esto, los avisos se cortan
             a media tarde y no falla nada visible. -->
        <service
            android:name=".AvisosService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Aparte de AvisosService a proposito: tipos distintos (`location`
             contra `dataSync`) y cada uno con su canal, asi que sin permiso de
             ubicacion los avisos siguen andando. -->
        <service
            android:name=".UbicacionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".ArranqueReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
